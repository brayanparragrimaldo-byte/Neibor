# Lo que vive en el repo pero no tiene que servirse como pagina.
# Mismo formato que .gitignore.

.git
.gitignore
.assetsignore
wrangler.jsonc

# Fuentes del sitio: index.html se arma a partir de estas.
_cuerpo.html
build.py
fondo-a-alfa.py

# El codigo del Worker. Cloudflare lo despliega como codigo, no como
# archivo: sin esta linea se podria bajar desde /worker/index.js.
worker

# Notas internas: pendientes, cifras que no cierran, decisiones de obra.
# Nada de esto va en la direccion publica.
README.md
CAMBIOS-MOCKUP-V1.md
DIAGNOSTICO.md

# Pagina de revision tecnica. Sirve para probar el sitio desde la maquina de
# alguien, no para que la abra cualquiera: nombra los archivos internos y
# cuenta las fallas conocidas.
diagnostico.html
