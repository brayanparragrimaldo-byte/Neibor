# Cabeceras del sitio, que Cloudflare lee de aca. Este archivo no se sirve: lo
# procesa Workers y aplica las reglas a las respuestas.
#
# Los nombres de archivo no llevan huella del contenido: cuando se corrige una
# imagen se pisa la anterior con el mismo nombre. Por eso la cache es corta
# mientras el sitio se sigue tocando. Cuando quede quieto, subir img a
# max-age=2592000 (30 dias), que es el verdadero ahorro: la carpeta pesa 30 MB.

# La direccion workers.dev no tiene que competir con la buena en el buscador.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Un ano de HTTPS obligatorio. Sin "preload", que es dificil de deshacer, y
  # sin "includeSubDomains", para no atar un subdominio que todavia no existe.
  Strict-Transport-Security: max-age=31536000
  # Que nadie pueda meter la pagina adentro de un marco en otro sitio y
  # mostrarla con sus propios telefonos encima. X-Frame-Options es lo mismo
  # para los navegadores viejos, que no entienden frame-ancestors.
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  # La pagina no pide camara, ni microfono, ni ubicacion, ni pagos. Dejarlo
  # escrito evita que algo inyectado pueda pedirlos.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), accelerometer=(), gyroscope=()
  # cloudflareinsights.com es la medicion de visitas que Cloudflare mete sola
  # en la pagina. No usa cookies ni sigue a nadie entre sitios. Si no se
  # quiere, se apaga en el panel (Web Analytics) y se saca de aca.
  # De donde puede salir cada cosa. 'unsafe-inline' esta en script y en style
  # porque el rescate de imagenes va en linea en el head y hay 37 atributos
  # style en el marcado. form-action 'none' es el que importa de verdad aca:
  # si el javascript fallara, el formulario no puede mandar los datos a
  # ningun lado por su cuenta.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self' https://static.cloudflareinsights.com; frame-ancestors 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests

/img/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/*.html
  Cache-Control: public, max-age=0, must-revalidate
